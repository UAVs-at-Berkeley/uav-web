---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'UAVs at Berkeley' } = Astro.props;
const normalizePath = (path: string) => (path.endsWith('/') ? path.slice(0, -1) : path);
const isHomePage = normalizePath(Astro.url.pathname) === normalizePath(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Navbar currentPath={Astro.url.pathname} />
		<main class={isHomePage ? 'home-main' : undefined}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--page-surface: color-mix(in oklab, var(--background) 92%, white);
		--page-surface-strong: color-mix(in oklab, var(--background) 84%, white);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background:
			radial-gradient(circle at top left, color-mix(in oklab, var(--background) 70%, #dbeafe) 0, transparent 32%),
			radial-gradient(circle at top right, color-mix(in oklab, var(--background) 72%, #e0e7ff) 0, transparent 28%),
			var(--background);
		color: var(--foreground);
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	main {
		max-width: 1160px;
		margin: 0 auto;
		padding: clamp(1rem, 2vw, 1.5rem);
	}

	main.home-main {
		padding-top: 0;
	}

	h1,
	h2,
	h3 {
		line-height: 1.2;
	}

	h1,
	h2,
	h3,
	p {
		text-wrap: balance;
	}

	section h2 {
		margin: 0 0 0.8rem;
	}
</style>
