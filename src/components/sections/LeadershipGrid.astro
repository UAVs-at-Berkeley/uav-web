---
interface Member {
  name: string;
  title: string;
  image: string;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;
---

<section class="leadership-grid">
  {
    members.map((member) => (
      <article>
        <img src={`${import.meta.env.BASE_URL}${member.image.startsWith('/') ? member.image.slice(1) : member.image}`} alt={member.name} loading="lazy" />
        <h3>{member.name}</h3>
        <p>{member.title}</p>
      </article>
    ))
  }
</section>

<style>
  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    justify-items: center;
    align-items: start;
  }

  article {
    border: 1px solid color-mix(in oklab, var(--border) 90%, white);
    border-radius: 1rem;
    padding: 1rem;
    background: var(--page-surface);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    text-align: center;
    width: 100%;
    max-width: 320px;
    justify-self: center;
  }

  img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--border) 90%, white);
  }

  h3 {
    margin: 0.7rem 0 0.25rem;
  }

  p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
